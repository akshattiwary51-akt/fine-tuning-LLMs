# Copy this file to `.env` and fill in real values. `.env` itself is gitignored
# and must never be committed.

# --- Secrets ---------------------------------------------------------------
# Required for model download and adapter upload. Get one at
# https://huggingface.co/settings/tokens (a "read" token is enough to download
# gated/base models; you'll need "write" to upload trained adapters).
HF_TOKEN=

# --- Model selection ---------------------------------------------------------
# true/false — whether to use the Unsloth-accelerated loading/training path.
USE_UNSLOTH=true
# "lora" or "qlora"
LORA_MODE=qlora
BASE_MODEL_HF=google/gemma-3-1b-it
BASE_MODEL_UNSLOTH=unsloth/gemma-3-1b-it

# --- Data --------------------------------------------------------------------
# Absolute path to the "Sentiment Analysis for Mental Health Dataset.csv" file.
DATASET_PATH=
TEST_SIZE=0.2
SEED=42

# --- Sequence length -----------------------------------------------------------
# Single source of truth for both model loading and SFTConfig.
MAX_SEQ_LENGTH=1024

# --- Paths ---------------------------------------------------------------------
OUTPUT_ROOT=./sft_output
LOCAL_MODEL_CACHE=./models

# --- Hugging Face Hub upload target ---------------------------------------------
# Either set HF_USERNAME (repo id will be derived as
# "<HF_USERNAME>/gemma-3-1b-it-<lora_mode>-<backend>"), or set the full repo id
# explicitly via HF_PERSONAL_REPO_ID. At least one is required to run upload.py.
HF_USERNAME=
HF_PERSONAL_REPO_ID=
